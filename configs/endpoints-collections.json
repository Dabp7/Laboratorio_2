{
  "info": {
    "name": "Adoption demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3003/adoptionSystem/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "petId",
      "value": ""
    },
    {
      "key": "futureSlot",
      "value": "2040-01-01T12:00:00Z"
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"alice@example.test\",\"password\":\"Demo-password-123!\"}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Catalog",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/pet/"
      }
    },
    {
      "name": "Book slot",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"pet\":\"{{petId}}\",\"date\":\"{{futureSlot}}\"}"
        },
        "url": "{{baseUrl}}/appointment/createAppointment"
      }
    }
  ]
}
